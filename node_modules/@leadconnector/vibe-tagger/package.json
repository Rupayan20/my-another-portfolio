{
  "name": "@leadconnector/vibe-tagger",
  "version": "0.3.1",
  "description": "Vite plugin that instruments React JSX elements with source-location metadata for visual editing",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --outDir dist",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist",
    "prepare": "npm run clean && npm run build"
  },
  "keywords": [
    "vite",
    "plugin",
    "react",
    "jsx",
    "source-map",
    "visual-editing",
    "component",
    "tagger"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vite": ">=5.0.0 <8.0.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/node": {
      "optional": true
    }
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "rimraf": "^5.0.10",
    "tsup": "^7.3.0",
    "typescript": "^5.5.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
